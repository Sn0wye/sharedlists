DATABASE_URL=postgres://sharedlists:sharedlists@localhost:5433/sharedlists
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
# Origin of the static frontend (CORS + post-login redirect)
WEB_URL=http://localhost:3000
# Optional extra allowed origins, comma-separated
EXTRA_ORIGINS=
# Public base URL of this API (OAuth redirect URIs: $PUBLIC_URL/auth/{google,github}/callback)
PUBLIC_URL=http://localhost:8080
# Set to "none" only if the web app and API are on different sites (not just subdomains)
COOKIE_SAMESITE=lax
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Web Push (optional). Generate with `cargo run -- vapid-keys`; without it the bell is hidden.
VAPID_PRIVATE_KEY=
# Contact for push services: mailto: or https: URL (Safari rejects http://localhost). Defaults to WEB_URL.
VAPID_SUBJECT=
